# Dependencies
node_modules/

# Build output and caches
dist/
coverage/
.turbo/
*.tsbuildinfo

# Secrets: never commit real environment files (CLAUDE.md Conventions)
.env
.env.*
!.env.example

# Local tool settings
.claude/settings.local.json

# OS and editor noise
.DS_Store
Thumbs.db
*.log

# Electron build output (electron-vite) and packaged apps (electron-builder)
packages/app/out/
packages/app/release/
packages/app/test-results/

# Embedding models, downloaded at build time by scripts/fetch-model.mjs
/models/*/

# Clones of the demo repositories, made by scripts/site-data.mjs
/.cache/
