# Normalize line endings: LF in the repository and in working trees on every OS
# (https://git-scm.com/docs/gitattributes#_eol). Prettier also expects LF.
* text=auto eol=lf

# Binary files: never touch line endings or diff as text.
*.wasm binary
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.gif binary
