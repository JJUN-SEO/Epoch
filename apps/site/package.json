{
  "name": "@epoch-dev/site",
  "version": "0.0.0",
  "private": true,
  "description": "Epoch's static site: landing page, downloads, and a demo viewer over precomputed graphs of public repositories (no backend, no source code).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@epoch-dev/core": "workspace:*",
    "@epoch-dev/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
