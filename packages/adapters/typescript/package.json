{
  "name": "@epoch-dev/adapter-typescript",
  "version": "0.0.0",
  "private": true,
  "description": "Epoch language adapter for TypeScript and JavaScript.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --dir src"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vscode/tree-sitter-wasm": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@epoch-dev/core": "workspace:*",
    "typescript": "catalog:",
    "web-tree-sitter": "catalog:",
    "yaml": "2.9.1"
  }
}
