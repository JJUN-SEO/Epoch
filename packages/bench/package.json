{
  "name": "@epoch-dev/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Epoch benchmarks (never shipped): performance, accuracy against ground-truth tools, and ADR measurements.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --dir src"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@epoch-dev/adapter-typescript": "workspace:*",
    "@epoch-dev/core": "workspace:*",
    "@epoch-dev/engine": "workspace:*",
    "dependency-cruiser": "18.5.0",
    "typescript": "catalog:"
  }
}
