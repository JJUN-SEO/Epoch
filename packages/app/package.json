{
  "name": "@epoch-dev/app",
  "version": "0.0.0",
  "private": true,
  "description": "Epoch desktop app: Electron main process, preload bridge and analysis host.",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "clean": "node -e \"for (const d of ['out','release']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "build": "pnpm run clean && electron-vite build",
    "dev": "electron-vite dev",
    "package:dir": "electron-builder --dir",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "catalog:",
    "better-sqlite3": "catalog:",
    "piscina": "catalog:",
    "typescript": "catalog:",
    "web-tree-sitter": "catalog:"
  },
  "devDependencies": {
    "@epoch-dev/core": "workspace:*",
    "@epoch-dev/engine": "workspace:*",
    "@epoch-dev/ui": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "43.7.7",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
