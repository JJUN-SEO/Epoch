{
  "name": "@epoch-dev/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Epoch renderer: React + Cytoscape UI written against EpochApi (used by the app and the static demo site).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@epoch-dev/core": "workspace:*",
    "cytoscape": "3.34.3",
    "cytoscape-fcose": "2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
