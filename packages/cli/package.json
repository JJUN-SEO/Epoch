{
  "name": "@epoch-dev/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Epoch CLI: the headless `epoch` command for analysis, benchmarks and CI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "epoch": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --dir src"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@epoch-dev/core": "workspace:*",
    "@epoch-dev/engine": "workspace:*",
    "@epoch-dev/scorers": "workspace:*"
  }
}
